<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutVipRowBg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1A1A2E"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/textTiger"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="#FFD700"
        android:text="🐅"
        android:textSize="30sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/textVipName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👑 VIP 1 • Black Tiger"
            android:textColor="#FFD700"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVipLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2,000,000 Coins"
            android:textColor="#FF4081"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/textEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐅 Black Tiger Entry • Black Royal Frame • Black Bubble"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#FFD700"
        android:textSize="30sp"
        android:textStyle="bold" />
</LinearLayout>
