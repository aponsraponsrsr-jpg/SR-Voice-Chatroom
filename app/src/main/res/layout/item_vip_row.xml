<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#2A1B4E"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- VIP Badge / Logo -->
    <ImageView
        android:id="@+id/imgVipBadge"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@android:drawable/ic_menu_star"
        android:layout_gravity="center_vertical" />

    <!-- Info Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/textVipName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIP 1"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVipLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exclusive Frame & Bubble"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/textEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Effect: Fire Tiger"
            android:textColor="#FF4081"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
