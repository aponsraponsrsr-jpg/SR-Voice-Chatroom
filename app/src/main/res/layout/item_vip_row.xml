<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutVipRowBg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1A1A2E"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <!-- PREMIUM FRAME - Circle + Gold Border -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">

        <TextView
            android:id="@+id/textTiger"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="#FFD700"
            android:text="🦁"
            android:textSize="30sp"
            android:gravity="center" />

        <!-- Crown Badge - Top Right -->
        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="#FFD700"
            android:text="👑"
            android:textSize="12sp"
            android:gravity="center" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <!-- VIP Name + Tiger Type -->
        <TextView
            android:id="@+id/textVipName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👑 VIP 7 • Fire Lion"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Coins - Gold -->
        <TextView
            android:id="@+id/textVipLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="50,000,000 Coins"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Entry + Frame + Bubble -->
        <TextView
            android:id="@+id/textEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 Fire Lion Entry • Fire Lion King Frame • Fire Gold Bubble"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- PREMIUM TAG - Rooh Style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ PREMIUM • 12 PRIVILEGES"
            android:textColor="#FFD700"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#33000000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Arrow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold" />
</LinearLayout>
