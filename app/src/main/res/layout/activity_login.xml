<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0B2E"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp">

    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="SR"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#FF4DFF"
        android:background="#2D1B4E"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SR Voice Chatroom"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE - VOICE PARTY - FRIENDS"
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to SR Voice"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnGoogle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Continue with Google"
        android:textColor="#1A0B2E"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permanent ID - One Time Only"
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginTop="25dp"/>

</LinearLayout>
