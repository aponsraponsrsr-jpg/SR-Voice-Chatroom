<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1035"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"
    android:gravity="center">

    <!-- Premium Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:background="#55FFFFFF" />

    <!-- TOP TABS - Premium -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#2A1B4E"
        android:padding="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txtProfileTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="#FFD700"
            android:paddingVertical="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtMembersTopTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Members"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:paddingVertical="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Avatar + Premium Gold Ring -->
    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginBottom="10dp">
        <androidx.cardview.widget.CardView
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_gravity="center"
            app:cardCornerRadius="59dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFD700">
            <androidx.cardview.widget.CardView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                app:cardCornerRadius="55dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/imgUserProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#FFE0B2" />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/imgUserFrame"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:scaleType="fitXY" />
    </FrameLayout>

    <!-- User Name -->
    <TextView
        android:id="@+id/txtUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- VIP Badge - Premium Gold -->
    <TextView
        android:id="@+id/txtUserVipBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="#FFD700"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Group Name -->
    <TextView
        android:id="@+id/txtGroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group Name"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <!-- ID & Level - Premium Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#33FFD700"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/txtUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 123456789 📋"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtUserLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Level 15"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Agency - Premium Green -->
    <LinearLayout
        android:id="@+id/layoutUserAgency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1E8E3E"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtUserAgency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ AGENCY ★"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Header Info - Premium Dark Card -->
    <LinearLayout
        android:id="@+id/layoutHeaderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A1B4E"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="👑 RoomOwner" android:textColor="#AAAAAA" android:textSize="14sp" />
            <TextView android:id="@+id/txtRoomOwner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Owner (ID:)" android:textColor="#FFD700" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌐 Language" android:textColor="#AAAAAA" android:textSize="14sp" />
            <TextView android:id="@+id/txtHeaderLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌍 Country" android:textColor="#AAAAAA" android:textSize="14sp" />
            <TextView android:id="@+id/txtHeaderCountry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="India" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🏷️ Tag" android:textColor="#AAAAAA" android:textSize="14sp" />
            <TextView android:id="@+id/txtHeaderTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friends" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reward Event Banner - Premium Gold -->
    <LinearLayout
        android:id="@+id/layoutRewardBanner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFD700"
        android:padding="12dp"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏆  Reward Event"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRewardValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="498 >"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Members / Admin Section - Premium -->
    <LinearLayout
        android:id="@+id/layoutMembersSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2A1B4E"
            android:padding="6dp">

            <TextView
                android:id="@+id/txtMembersTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Members"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="#FFD700"
                android:paddingVertical="7dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtAdminTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:paddingVertical="7dp"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMembersCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members: 1/1000    Admin: 1/20"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHeaderMembersList"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Follow - Java diye GONE thakbe -->
    <Button
        android:id="@+id/btnFollow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="➕ Follow"
        android:textColor="#000000"
        android:textStyle="bold"
        android:backgroundTint="#FFD700"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

</LinearLayout>
