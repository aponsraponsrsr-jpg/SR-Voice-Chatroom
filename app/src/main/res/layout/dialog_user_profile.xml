<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_plus_btn" 
    android:padding="20dp"
    android:gravity="center">

    <!-- User Profile Picture (Circular) -->
    <ImageView
        android:id="@+id/imgUserProfile"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_myplaces"
        android:background="@drawable/bg_plus_btn"
        android:layout_marginBottom="10dp"/>

    <!-- User Name -->
    <TextView
        android:id="@+id/txtUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ID & Level Badges -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 123456789"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/txtUserLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Level 15"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Action Buttons (Follow, Chat, Gift Box) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <!-- Follow Button -->
        <Button
            android:id="@+id/btnFollow"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.5"
            android:text="➕ Follow"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E676"
            android:layout_marginEnd="8dp"/>

        <!-- Chat Button -->
        <Button
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.5"
            android:text="💬 Chat"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#00B0FF"
            android:layout_marginEnd="8dp"/>

        <!-- Gift Box Button -->
        <Button
            android:id="@+id/btnGift"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="🎁"
            android:textSize="18sp"
            android:backgroundTint="#FF4081"/>

    </LinearLayout>

</LinearLayout>
