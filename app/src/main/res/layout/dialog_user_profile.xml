<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:gravity="center">

    <!-- TOP TABS - Demo onujayi Profile / Members -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/txtProfileTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtMembersTopTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Members"
            android:textSize="16sp"
            android:textColor="#999999"
            android:gravity="center" />
    </LinearLayout>

    <!-- User Profile Picture -->
    <androidx.cardview.widget.CardView
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:cardCornerRadius="45dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="10dp">
        <ImageView
            android:id="@+id/imgUserProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#FFE0B2" />
    </androidx.cardview.widget.CardView>

    <!-- User Name -->
    <TextView
        android:id="@+id/txtUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Group Name -->
    <TextView
        android:id="@+id/txtGroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group Name"
        android:textColor="#666666"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <!-- ID & Level -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="#FFF3E0"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/txtUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 123456789 📋"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtUserLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Level 15"
            android:textColor="#00C853"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Header Info - RoomOwner / Language / Country / Tag -->
    <LinearLayout
        android:id="@+id/layoutHeaderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF8E1"
        android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RoomOwner" android:textColor="#666666" android:textSize="14sp" />
            <TextView android:id="@+id/txtRoomOwner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Owner (ID:)" android:textColor="#FF9800" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Language" android:textColor="#666666" android:textSize="14sp" />
            <TextView android:id="@+id/txtHeaderLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" android:textColor="#000000" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Country" android:textColor="#666666" android:textSize="14sp" />
            <TextView android:id="@+id/txtHeaderCountry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="India" android:textColor="#000000" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tag" android:textColor="#666666" android:textSize="14sp" />
            <TextView android:id="@+id/txtHeaderTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friends" android:textColor="#000000" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reward Event Banner -->
    <LinearLayout
        android:id="@+id/layoutRewardBanner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF9800"
        android:padding="12dp"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏆  Reward Event"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRewardValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="498 >"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Members / Admin Section -->
    <LinearLayout
        android:id="@+id/layoutMembersSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtMembersTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Members"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtAdminTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin"
                android:textSize="15sp"
                android:textColor="#666666"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMembersCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members: 1/1000    Admin: 1/20"
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHeaderMembersList"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Follow Button Only - Header e Java diye GONE thakbe -->
    <Button
        android:id="@+id/btnFollow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="➕ Follow"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#00C853"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

</LinearLayout>
