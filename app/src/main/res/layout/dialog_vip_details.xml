<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1233"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/textDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👑 VIP 1 • Black Tiger"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textTigerPreview"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="#FFD700"
        android:text="🐅"
        android:textSize="60sp"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4"
        android:layout_marginBottom="14dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/textBadgePreview" android:layout_width="52dp" android:layout_height="52dp" android:background="#FFD700" android:text="👑" android:textSize="24sp" android:gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Badge" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/textFramePreview" android:layout_width="52dp" android:layout_height="52dp" android:background="#9C27B0" android:text="🖼️" android:textSize="24sp" android:gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frame" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/textBubblePreview" android:layout_width="52dp" android:layout_height="52dp" android:background="#00BCD4" android:text="💬" android:textSize="24sp" android:gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bubble" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/textEffectPreview" android:layout_width="52dp" android:layout_height="52dp" android:background="#FF5722" android:text="🐅" android:textSize="24sp" android:gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entry" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textDetailDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Black Tiger Entry Effect\n• Black Royal Frame\n• Black Bubble\n• Golden Badge\n• Validity: 7 / 15 / 30 Days (Admin Controlled)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="15dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnBuyVip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buy - 2,000,000 Coins (Coming Soon)"
        android:textColor="#FFFFFF"
        android:backgroundTint="#555555"
        android:enabled="false"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF4081" />
</LinearLayout>
