<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1233"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/textDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👑 VIP Details &amp; Privileges"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="15dp" />

    <!-- Big Badge Preview -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="#FFD700"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginBottom="15dp"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑"
            android:textSize="36sp" />
    </LinearLayout>

    <!-- Privileges Description -->
    <TextView
        android:id="@+id/textDetailDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Exclusive Profile Frame\n• Custom Chat Bubble\n• Premium Entry Effect &amp; Badge"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="15dp" />

    <!-- Validity Info -->
    <TextView
        android:id="@+id/textValidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Validity Options: 7 Days / 10 Days / 30 Days (Admin Controlled)"
        android:textColor="#FF4081"
        android:textSize="12sp"
        android:layout_marginBottom="20dp"
        android:gravity="center" />

    <!-- Buy Button (Disabled / Closed for now) -->
    <Button
        android:id="@+id/btnBuyVip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buy - 2,000,000 Coins (Coming Soon)"
        android:textColor="#FFFFFF"
        android:backgroundTint="#555555"
        android:enabled="false"
        android:layout_marginBottom="10dp" />

    <!-- Close Button -->
    <Button
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF4081" />

</LinearLayout>
