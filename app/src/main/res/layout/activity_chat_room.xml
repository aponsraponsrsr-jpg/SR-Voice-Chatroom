<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Room Info -->
    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#1E1E1E">

        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SR Voice Room"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Seats - 8 Seats -->
    <GridLayout
        android:id="@+id/seatsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topLayout"
        android:columnCount="4"
        android:rowCount="2"
        android:padding="15dp" />

    <!-- Bottom Bar - Real Icons like Photo 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="5">

        <ImageView android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:src="@android:drawable/ic_media_play" />
        <ImageView android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:src="@android:drawable/ic_menu_gallery" />
        <ImageView android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:src="@android:drawable/ic_input_add" />
        <ImageView android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:src="@android:drawable/ic_dialog_email" />
        <ImageView android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:src="@android:drawable/ic_menu_send" />

    </LinearLayout>

</RelativeLayout>
