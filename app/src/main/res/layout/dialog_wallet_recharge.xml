<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#120A2A"
    android:padding="20dp">

    <!-- Top Bar: Title & Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💰 Wallet &amp; Recharge Center"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseRecharge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:padding="5dp" />
    </LinearLayout>

    <!-- User Coin Balance Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A1B4E"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Available Balance"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="5dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 "
                android:textSize="22sp" />

            <TextView
                android:id="@+id/textUserBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="411 Coins"
                android:textColor="#FFD700"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Section Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Recharge Package (Reseller &amp; Demo Mode)"
        android:textColor="#FF4081"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp" />

    <!-- Recharge Packages List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Package 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#2A1B4E"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💎 1,00,000 Coins"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="$0.99 (Coming Soon)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#555555"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Package 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#2A1B4E"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💎 5,00,000 Coins"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="$4.99 (Coming Soon)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#555555"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Package 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#2A1B4E"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💎 10,000,000 Coins"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="$9.99 (Coming Soon)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#555555"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Package 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#2A1B4E"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💎 50,000,000 Coins"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="$49.99 (Coming Soon)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#555555"
                    android:enabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Notice Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Direct card purchases are temporarily disabled. Please contact official resellers for coin recharge."
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="15dp" />

</LinearLayout>
