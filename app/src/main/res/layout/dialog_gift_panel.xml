<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1035"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:background="#55FFFFFF"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎁 SR Luxury Gift Center"
            android:textColor="#FFD700"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUserCoinBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 999,999 Coins"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#33FFD700"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- Target Row - বাম কোনায় ছোট্ট Popup + ছোট্ট Marble গোল Profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <!-- বাম কোনায় ছোট্ট গোল Popup - All Mic / All Room -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/btnTargetPopup"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFD700">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👥"
                    android:textSize="20sp" />
            </androidx.cardview.widget.CardView>
            <!-- ছোট্ট Dot - Popup আছে বুঝানোর জন্য -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="#00E676" />
        </FrameLayout>

        <!-- Marble গোল - ছোট্ট ছোট্ট - 52dp - বড় না -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGiftTargets"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:orientation="horizontal" />
    </LinearLayout>

    <EditText
        android:id="@+id/editTargetSeat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#2A1B4E"
        android:textColor="#FFFFFF"
        android:hint="Target Seat" />

    <TextView
        android:id="@+id/txtGiftCount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="x1" />

    <!-- Gift Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGifts"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="12dp" />

    <!-- Bottom - To + Quantity + Send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSelectedTargetId"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#2A1B4E"
            android:text="To: All Mic"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp" />

        <!-- Quantity - ছোট্ট Pill - x1 / x5 / x10 -->
        <Button
            android:id="@+id/btnGiftQuantity"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="x1"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FFD700" />

        <Button
            android:id="@+id/btnGiftCount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="x1" />

        <Button
            android:id="@+id/btnSendGift"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="🚀 Send"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF4081" />
    </LinearLayout>

</LinearLayout>
