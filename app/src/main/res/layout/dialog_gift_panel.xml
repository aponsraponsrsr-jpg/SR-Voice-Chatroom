<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_gradient"
    android:padding="20dp">

    <!-- হেডার: প্রোফাইলের ওখানে কয়েন ওয়ালেট -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎁 SR Luxury Gift Center"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ভিডিওর আদলে প্রিমিয়াম লাইভ কয়েন কাউন্টার -->
        <TextView
            android:id="@+id/txtUserCoinBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 999,999 Coins"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ক্যাটাগরি ট্যাব ও সিলেকশন অপশন -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2A1B4E"
        android:padding="5dp"
        android:layout_marginBottom="15dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select: All | Single Mic"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:paddingHorizontal="10dp" />

        <!-- All/Single Mic বাটন লজিক এখানে যুক্ত করবে (checkbox বা বাটন দিয়ে) -->
    </LinearLayout>

    <!-- গিফট গ্রিড লিস্ট (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGifts"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="15dp" />

    <!-- সেন্ড বাটন -->
    <Button
        android:id="@+id/btnSendGift"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🚀 Send Luxury Gift"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FF4081" />

</LinearLayout>
