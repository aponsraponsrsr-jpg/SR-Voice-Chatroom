<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1035"
    android:padding="20dp">

    <!-- প্যানেল টাইটেল ও হেডার -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎁 SR Luxury Gift Center"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUserCoinBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 999,999 Coins"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- টার্গেট সিট বা ইউজার সিলেকশন ঘর -->
    <EditText
        android:id="@+id/editTargetSeat"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#2A1B4E"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:hint="Target Seat (0 to 9 or type 'All')..."
        android:textSize="14sp"
        android:paddingHorizontal="15dp"
        android:layout_marginBottom="12dp" />

    <!-- গিফট গ্রিড লিস্ট (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGifts"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="15dp" />

    <!-- সেন্ড বাটন -->
    <Button
        android:id="@+id/btnSendGift"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🚀 Send Luxury Gift"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FF4081" />

</LinearLayout>
