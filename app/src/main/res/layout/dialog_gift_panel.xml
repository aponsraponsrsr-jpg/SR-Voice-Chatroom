<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1035"
    android:padding="16dp">

    <!-- Title + Balance - তোমার আগেরটাই -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎁 SR Luxury Gift Center"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUserCoinBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 999,999 Coins"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- NEW: উপরে Active Profile Row - Gift এর ঠিক উপরে -->
    <!-- All Mic / All Room / নিজের ID / Active সবাই এইখানে আসবে -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGiftTargets"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp" />

    <!-- পুরাতন Target Edit - লুকানো রাখলাম, যাতে পুরাতন Code না ভাঙে -->
    <EditText
        android:id="@+id/editTargetSeat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#2A1B4E"
        android:textColor="#FFFFFF"
        android:hint="Target Seat" />

    <!-- Gift Grid - তোমার আগেরটাই -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGifts"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="12dp" />

    <!-- NEW: নিচের Bar - Target ID + Quantity Menu + Send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Target ID দেখাবে - যাকে Select করবা -->
        <TextView
            android:id="@+id/tvSelectedTargetId"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#2A1B4E"
            android:text="To: All Mic"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp" />

        <!-- Quantity Menu - x1 তে Touch করলে ছোট Popup - 1 / 5 / 10 -->
        <Button
            android:id="@+id/btnGiftQuantity"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="x1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2A1B4E" />

        <!-- Send - তোমার আগের ID টাই রাখলাম -->
        <Button
            android:id="@+id/btnSendGift"
            android:layout_width="110dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="🚀 Send"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF4081" />
    </LinearLayout>

</LinearLayout>
