<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- TOP BAR: Mine | Hot | Discover + Search -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#121212"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mine" android:textColor="#FFC107" android:textStyle="bold" android:textSize="18sp" android:layout_marginEnd="20dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hot" android:textColor="#888888" android:textSize="16sp" android:layout_marginEnd="20dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Discover" android:textColor="#888888" android:textSize="16sp"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
        <TextView android:id="@+id/btnSearch" android:layout_width="36dp" android:layout_height="36dp" android:text="🔍" android:textSize="20sp" android:gravity="center" android:background="#2A2A2A" android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- BANNER: SR Official SR Voice Chatroom & Come In Soon -->
    <LinearLayout
        android:id="@+id/bannerTop"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_below="@id/topBar"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="SR Official SR Voice Chatroom &amp; Come In Soon" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" android:ellipsize="marquee"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textColor="#FFC107" android:textSize="14sp" android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- HOME GRID: 4 Rooms SR Official -->
    <GridLayout
        android:id="@+id/gridRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/bannerTop"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="8dp">

        <!-- Room 1 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:orientation="vertical" android:background="#2C2C2C" android:layout_margin="6dp" android:gravity="center" android:padding="8dp">
            <TextView android:layout_width="60dp" android:layout_height="60dp" android:text="SR" android:background="#FFC107" android:gravity="center" android:textStyle="bold" android:textSize="20sp" android:textColor="#000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SR Official" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="8dp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="999+ talking" android:textColor="#888888" android:textSize="10sp"/>
        </LinearLayout>

        <!-- Room 2 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:orientation="vertical" android:background="#2C2C2C" android:layout_margin="6dp" android:gravity="center" android:padding="8dp">
            <TextView android:layout_width="60dp" android:layout_height="60dp" android:text="SR" android:background="#FFC107" android:gravity="center" android:textStyle="bold" android:textSize="20sp" android:textColor="#000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SR Official" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="8dp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SR Voice" android:textColor="#888888" android:textSize="10sp"/>
        </LinearLayout>

        <!-- Room 3 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:orientation="vertical" android:background="#2C2C2C" android:layout_margin="6dp" android:gravity="center" android:padding="8dp">
            <TextView android:layout_width="60dp" android:layout_height="60dp" android:text="SR" android:background="#FFC107" android:gravity="center" android:textStyle="bold" android:textSize="20sp" android:textColor="#000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SR Official" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="8dp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Come In Soon" android:textColor="#888888" android:textSize="10sp"/>
        </LinearLayout>

        <!-- Room 4 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="140dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:orientation="vertical" android:background="#2C2C2C" android:layout_margin="6dp" android:gravity="center" android:padding="8dp">
            <TextView android:layout_width="60dp" android:layout_height="60dp" android:text="SR" android:background="#FFC107" android:gravity="center" android:textStyle="bold" android:textSize="20sp" android:textColor="#000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SR Official" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="8dp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Official Room" android:textColor="#888888" android:textSize="10sp"/>
        </LinearLayout>

    </GridLayout>

    <!-- WEEKLY STAR BANNER -->
    <LinearLayout
        android:id="@+id/bannerWeekly"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_below="@id/gridRooms"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐ Weekly Star CP &amp; Family" android:textColor="#FFC107" android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- BOTTOM NAV: Right Side Corner - Mine | Inbox | Moment | Home -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:gravity="center_vertical">

        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>

        <LinearLayout android:layout_width="60dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="22sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="60dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💫" android:textSize="22sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moment" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="60dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📩" android:textSize="22sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inbox" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="60dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="22sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mine" android:textColor="#FFC107" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
