<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0A1E">

    <!-- Top Bar -->
    <TextView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌟 SR Voice Chatroom"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#E91E63"/>

    <!-- Center Welcome Text -->
    <TextView
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome! Tap + to create room"
        android:textColor="#AAAAAA"
        android:textSize="14sp"/>

    <!-- Bottom Navigation Bar (Home, Moment, Plus, Me) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#1A1333"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnHomeTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏠 Home"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMomentTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✨ Moment"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <!-- মাঝখানের প্লাস (+) আইকন -->
        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_plus_btn"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginHorizontal="12dp"/>

        <Button
            android:id="@+id/btnMeTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Me"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</RelativeLayout>
