<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0A1E">

    <!-- Top Bar with Popular & Search Icon -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E91E63"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Popular"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Search Icon on Right Side -->
        <ImageView
            android:id="@+id/btnSearchRoom"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search Room"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Grid View for Premium Room Cards -->
    <GridView
        android:id="@+id/roomGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarLayout"
        android:layout_above="@id/bottomNavLayout"
        android:numColumns="2"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:padding="8dp"
        android:stretchMode="columnWidth"/>

    <!-- Bottom Navigation Bar (Home, Moment, Plus, Me) -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#1A1333"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnHomeTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏠 Home"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMomentTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✨ Moment"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <!-- মাঝখানের প্লাস (+) আইকন -->
        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_plus_btn"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginHorizontal="8dp"/>

        <Button
            android:id="@+id/btnMeTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Me"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</RelativeLayout>
