<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0A1E">

    <!-- Top Bar with Tabs, Search Icon & Top Create Room (+) Icon -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E91E63"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main"
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:layout_marginEnd="12sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hot"
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:layout_marginEnd="12sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Popular"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Search Icon -->
        <ImageView
            android:id="@+id/btnSearchRoom"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search Room"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <!-- Top Create Room (+) Icon -->
        <ImageView
            android:id="@+id/btnCreateRoomTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Create Room"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Scrollable Content Area containing Banner and Grid View -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarLayout"
        android:layout_above="@id/bottomNavLayout"
        android:orientation="vertical">

        <!-- Banner / Slider Area -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1A1333"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2A1B4E">

                <TextView
                    android:id="@+id/bannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌟 SR Voice Chatroom Official"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_centerInParent="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Global Voice Community"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_below="@id/bannerTitle"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Grid View for Premium Room Cards -->
        <GridView
            android:id="@+id/roomGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:horizontalSpacing="4dp"
            android:verticalSpacing="4dp"
            android:padding="8dp"
            android:stretchMode="columnWidth"/>

    </LinearLayout>

    <!-- Bottom Navigation Bar (Home, Moment, Plus/Inbox, Me) -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#1A1333"
        android:gravity="center"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btnHomeTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏠 Home"
            android:textSize="10sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMomentTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✨ Moment"
            android:textSize="10sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <!-- মাঝখানের প্লাস (+) আইকন -->
        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_plus_btn"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginHorizontal="4dp"/>

        <!-- নতুন ইনবক্স ট্যাব -->
        <Button
            android:id="@+id/btnInboxTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📥 Inbox"
            android:textSize="10sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMeTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Me"
            android:textSize="10sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</RelativeLayout>
