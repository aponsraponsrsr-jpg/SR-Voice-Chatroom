<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Setup Your Profile"
        android:textColor="#E5C158"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Choose your profile picture, name and gender"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <!-- Profile Image Selection -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:background="#2A2A2A"
        android:contentDescription="Profile Picture"
        android:padding="16dp"
        android:src="@android:drawable/ic_menu_camera" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tap to change photo"
        android:textColor="#E5C158"
        android:textSize="12sp" />

    <!-- Name Input Field -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:background="#1A1A1A"
        android:hint="Enter your name"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:textSize="16sp" />

    <!-- Gender Selection Layout -->
    <RadioGroup
        android:id="@+id/rgGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <RadioButton
            android:id="@+id/rbMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="Male"
            android:textColor="#FFFFFF"
            android:buttonTint="#E5C158" />

        <RadioButton
            android:id="@+id/rbFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female"
            android:textColor="#FFFFFF"
            android:buttonTint="#E5C158" />
    </RadioGroup>

    <!-- Save & Enter Home Button -->
    <Button
        android:id="@+id/btnSaveAndEnter"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#E5C158"
        android:text="Save &amp; Enter Chatroom"
        android:textAllCaps="false"
        android:textColor="#121212"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
