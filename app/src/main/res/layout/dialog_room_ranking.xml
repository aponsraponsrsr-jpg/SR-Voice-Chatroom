<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#120A2A"
    android:padding="20dp">

    <!-- হেডার ও ক্লোজ বাটন - আগের টাই আছে -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="15dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏆 Room Contribution Ranking"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:padding="5dp" />
    </LinearLayout>

    <!-- ডেইলি, উইকলি, মান্থলি ট্যাব - আগের টাই আছে -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2A1B4E"
        android:padding="4dp"
        android:layout_marginBottom="15dp">

        <Button
            android:id="@+id/btnTabDaily"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Daily"
            android:textColor="#000000"
            android:backgroundTint="#FFD700"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabWeekly"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Weekly"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A1B4E" />

        <Button
            android:id="@+id/btnTabMonthly"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Monthly"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A1B4E" />
    </LinearLayout>

    <!-- ADD - Top 1, Top 2, Top 3 Podium - Premium Look -->
    <LinearLayout
        android:id="@+id/layoutTop3Podium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginBottom="15dp">

        <!-- Top 2 - Left -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥈" android:textSize="24sp" />
            <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp" app:cardCornerRadius="28dp" app:cardElevation="0dp">
                <ImageView android:id="@+id/imgTop2Photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#C0C0C0" />
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/txtTop2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top 2" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/txtTop2Coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 🪙" android:textColor="#C0C0C0" android:textSize="11sp" />
            <View android:layout_width="match_parent" android:layout_height="40dp" android:background="#C0C0C0" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Top 1 - Center, Sobar Boro + Crown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textSize="28sp" />
            <androidx.cardview.widget.CardView android:layout_width="72dp" android:layout_height="72dp" app:cardCornerRadius="36dp" app:cardElevation="0dp">
                <ImageView android:id="@+id/imgTop1Photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#FFD700" />
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/txtTop1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top 1" android:textColor="#FFD700" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/txtTop1Coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 🪙" android:textColor="#FFD700" android:textSize="12sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="70dp" android:background="#FFD700" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Top 3 - Right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="30dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥉" android:textSize="24sp" />
            <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp" app:cardCornerRadius="28dp" app:cardElevation="0dp">
                <ImageView android:id="@+id/imgTop3Photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#CD7F32" />
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/txtTop3Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top 3" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/txtTop3Coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 🪙" android:textColor="#CD7F32" android:textSize="11sp" />
            <View android:layout_width="match_parent" android:layout_height="30dp" android:background="#CD7F32" android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- র‍্যাঙ্কিং লিস্ট কন্টেইনার - আগের টাই আছে, 4th থেকে নিচে সবাই এখানে আসবে -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rankingListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
