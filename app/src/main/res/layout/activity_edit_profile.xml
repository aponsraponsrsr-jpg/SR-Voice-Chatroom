<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0A1E"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Complete Your Profile"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender, Location and ID will be permanently locked!"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="30dp"
        android:gravity="center"/>

    <!-- প্রোফাইল পিকচার সিলেকশন -->
    <ImageView
        android:id="@+id/imgProfilePic"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_camera"
        android:background="#2E2355"
        android:scaleType="centerCrop"
        android:layout_marginBottom="20dp"
        android:padding="20dp"/>

    <!-- নাম ইনপুট -->
    <EditText
        android:id="@+id/inputName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter Your Name"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#1A1333"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:maxLines="1"/>

    <!-- জেন্ডার সিলেকশন (Male / Female) -->
    <Spinner
        android:id="@+id/spinnerGender"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1A1333"
        android:layout_marginBottom="16dp"/>

    <!-- লোকেশন ইনপুট -->
    <EditText
        android:id="@+id/inputLocation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter Your Country / Location"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#1A1333"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="30dp"
        android:maxLines="1"/>

    <!-- কনফার্ম ও সেভ বাটন -->
    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Save &amp; Enter App"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#E91E63"/>

</LinearLayout>
