<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Profile Picture with Camera Icon -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgEditProfilePic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#44FFFFFF"
                android:scaleType="centerCrop"
                android:elevation="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="24sp"
                android:layout_gravity="bottom|end"
                android:background="#9C27B0"
                android:padding="4dp"
                android:elevation="6dp"/>
        </FrameLayout>

        <!-- Name Input Field -->
        <EditText
            android:id="@+id/editUserName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#33000000"
            android:hint="Enter your stylish name..."
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:singleLine="true"/>

        <!-- Location Input Field -->
        <EditText
            android:id="@+id/editUserLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#33000000"
            android:hint="Enter your country/location..."
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:singleLine="true"/>

        <!-- Gender Selection Spinner -->
        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#33000000"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="✨ Save Profile"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#E91E63"
            android:elevation="4dp"/>

    </LinearLayout>
</ScrollView>
