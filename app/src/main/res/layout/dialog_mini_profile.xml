<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMiniRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1035"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="28dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to View Full Profile →"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:paddingBottom="10dp" />

    <!-- Avatar + VIP Frame -->
    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginBottom="12dp">
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            app:cardCornerRadius="55dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/imgMiniPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#FFE0B2" />
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/imgMiniFrame"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:scaleType="fitXY" />
    </FrameLayout>

    <!-- 1st Row: Name + Gender + Flag -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtMiniName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtMiniGenderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♂"
            android:textColor="#00B0FF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/txtMiniFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇧🇩"
            android:textSize="19sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- NEW - VIP Badge - Namer thik niche -->
    <TextView
        android:id="@+id/txtMiniVipBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD700"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#33FFD700"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtMiniGenderCountry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- 2nd Row: Level + ID -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">
        <TextView
            android:id="@+id/txtMiniLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Lv.0"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#22000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/txtMiniId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 123456789  📋"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#22000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMiniSending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/txtMiniReceiving"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- FIXED - Agency Banner - Icon NAI, Name NAI, Sudhu AGENCY - Premium Gold -->
    <LinearLayout
        android:id="@+id/layoutMiniAgency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFD700"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtMiniAgency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGENCY"
            android:textColor="#1A0B2E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMiniHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#22000000"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎙️ Host"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/txtMiniHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="18dp">
        <Button
            android:id="@+id/btnMiniAddLeft"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Add Friend"
            android:textSize="12sp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#00B0FF"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnMiniGift"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🎁 Gift"
            android:textSize="12sp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF4081"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnMiniFollowRight"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="➕ Follow"
            android:textSize="12sp"
            android:maxLines="1"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E676"
            android:paddingHorizontal="2dp" />
    </LinearLayout>
</LinearLayout>
