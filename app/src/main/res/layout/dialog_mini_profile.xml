<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMiniRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1035"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="22dp"
    android:gravity="center">

    <!-- Premium Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:background="#55FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to View Full Profile →"
        android:textColor="#FFD700"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="6dp" />

    <!-- Avatar - ONLY Circle - No Square Frame -->
    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginBottom="10dp">
        <androidx.cardview.widget.CardView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            app:cardCornerRadius="64dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFD700">
            <ImageView
                android:id="@+id/imgMiniPhoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:background="#FFE0B2" />
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/imgMiniFrame"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:scaleType="fitXY" />
    </FrameLayout>

    <!-- 1st Row: Name + Gender + Flag -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtMiniName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/txtMiniGenderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♂️"
            android:textColor="#00B0FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="7dp" />
        <TextView
            android:id="@+id/txtMiniFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇧🇩 BD"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="7dp" />
    </LinearLayout>

    <!-- VIP Badge -->
    <TextView
        android:id="@+id/txtMiniVipBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#FFD700"
        android:paddingHorizontal="18dp"
        android:paddingVertical="7dp"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtMiniGenderCountry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- 2nd Row: Level + ID - Only Icons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/txtMiniLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💎 Lv.1   💖 Lv.1"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/txtMiniId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 123456789  📋"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#44FFFFFF"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- Wallet Removed -->
    <TextView
        android:id="@+id/txtMiniSending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/txtMiniReceiving"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Agency -->
    <LinearLayout
        android:id="@+id/layoutMiniAgency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1E8E3E"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtMiniAgency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ AGENCY ★"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMiniHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#22000000"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎙️ Host"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/txtMiniHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">
        <Button
            android:id="@+id/btnMiniAddLeft"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Add Friend"
            android:textSize="13sp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#00B0FF"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnMiniGift"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🎁 Gift"
            android:textSize="13sp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF4081"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnMiniFollowRight"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="➕ Follow"
            android:textSize="13sp"
            android:maxLines="1"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:paddingHorizontal="2dp" />
    </LinearLayout>
</LinearLayout>
