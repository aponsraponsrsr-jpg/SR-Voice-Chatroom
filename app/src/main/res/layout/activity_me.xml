<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0518"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1035"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">
            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginRight="15dp"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent">
                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar" />
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="ID: 000000000"
                    android:textColor="#00E676"
                    android:textSize="13sp" />
                <!-- FIX 1 - Default ar Male / BD na - Neutral - Java theke Global Flag + Gender asbe -->
                <TextView
                    android:id="@+id/txtGenderCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="🌍"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />
                <!-- SMALL ICONS ROW - VIP + WEALTH + CHARM - NO BANNER -->
                <LinearLayout
                    android:id="@+id/levelIconsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">
                    <!-- VIP SMALL ICON - Java theke LevelUtils color asbe, XML e Fixed na -->
                    <TextView
                        android:id="@+id/txtVipBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="#FFD700"
                        android:gravity="center"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                    <!-- WEALTH SMALL ICON - SENDING -->
                    <TextView
                        android:id="@+id/txtWealthBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginLeft="6dp"
                        android:background="#2196F3"
                        android:gravity="center"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="💎 1"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <!-- CHARM SMALL ICON - RECEIVING -->
                    <TextView
                        android:id="@+id/txtCharmBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginLeft="6dp"
                        android:background="#E91E63"
                        android:gravity="center"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="💖 1"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textColor="#B0BEC5"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="10dp" />
        </LinearLayout>
        <!-- Copy ID Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#140B26"
            android:padding="12dp"
            android:paddingHorizontal="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy ID"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- Stats Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1035"
            android:orientation="horizontal"
            android:padding="15dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/txtFollow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Follow" android:textColor="#B0BEC5" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/txtFans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fans" android:textColor="#B0BEC5" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/txtVisitor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visitor" android:textColor="#B0BEC5" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">
            <!-- SVIP Center - PERMANENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2A1B4E"
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑 SVIP Center" android:textColor="#FFD700" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtSvipStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get SVIP and enjoy privileges >" android:textColor="#B0BEC5" android:textSize="12sp" android:paddingTop="3dp" />
            </LinearLayout>
            <!-- My Wallet - PERMANENT -->
            <LinearLayout
                android:id="@+id/walletBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2A1B4E"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰 My Wallet" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtWalletCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coins: 0" android:textColor="#FFD700" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View Bill  >" android:textColor="#FFD700" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <!-- SELLER BUSINESS WALLET - ONLY SELLER SEES -->
            <LinearLayout
                android:id="@+id/sellerWalletBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00C853"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏪 Seller Business Wallet" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtSellerBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Business Coins: 0" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sell Coins  >" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <!-- VIP & Recharge Row - PERMANENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="#2A1B4E" android:orientation="vertical" android:padding="15dp" android:layout_marginRight="5dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑 VIP" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtVipStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check now >" android:textColor="#B0BEC5" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="#2A1B4E" android:orientation="vertical" android:padding="15dp" android:layout_marginLeft="5dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎁 Recharge" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top up >" android:textColor="#B0BEC5" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="General Tools" android:textColor="#B0BEC5" android:textSize="13sp" android:textStyle="bold" android:paddingBottom="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1B1035"
                android:orientation="horizontal"
                android:padding="15dp"
                android:layout_marginBottom="15dp"
                android:weightSum="4">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:text="🛍️" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Store" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:text="👗" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Dress" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:text="🎂" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Birthday" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutLevelBtn"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:text="📊" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Level" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnLogoutLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2A1B4E"
                android:gravity="center"
                android:padding="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚪 Log Out" android:textColor="#FF4081" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
