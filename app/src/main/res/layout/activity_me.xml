<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Profile Icon / Placeholder -->
    <ImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="40dp"
        android:background="#2A2A2A"
        android:padding="20dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:tint="#E5C158" />

    <!-- User Name -->
    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="User Name"
        android:textColor="#E5C158"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- User ID -->
    <TextView
        android:id="@+id/tvProfileId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="ID: 0000000"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <!-- Gender -->
    <TextView
        android:id="@+id/tvProfileGender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gender: Male"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <!-- Wallet Option -->
    <TextView
        android:id="@+id/tvWalletCoins"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🪙 Coins: 1,000"
        android:textColor="#E5C158"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

    <!-- VIP Status Option -->
    <TextView
        android:id="@+id/tvVipStatus"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="👑 VIP: Not Active"
        android:textColor="#E5C158"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
