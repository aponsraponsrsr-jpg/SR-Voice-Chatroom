<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- 🌟 প্রিমিয়াম গ্রেডিয়েন্ট ব্যাকগ্রাউন্ড (কোড দিয়ে তৈরি) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20px">

        <!-- হেডার (Edit Profile বাটন) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎ Edit Profile"
                android:backgroundTint="#7A1FA2"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:layout_alignParentEnd="true"
                android:textSize="12sp"/>
        </RelativeLayout>

        <!-- প্রোফাইল পিকচার (SR লোগো) -->
        <ImageView
            android:id="@+id/imgUserProfile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="30dp"
            android:src="@android:drawable/ic_menu_my_calendar" />

        <!-- ইউজার নেম -->
        <TextView
            android:id="@+id/textUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sr-Apon"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <!-- SR আইডি এবং কপি আইকন -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:background="#1AFFFFFF"
            android:padding="5dp">
            <TextView
                android:id="@+id/textUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 493859069"
                android:textColor="#FFEB3B"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- ফলোয়ার্স/ফ্যান্স/ভিজিটরস কাউন্ট কার্ড -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:background="#33FFFFFF"
            android:padding="20dp"
            android:gravity="center">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:text="Followers"
                    android:textColor="#DDFFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:text="Fans"
                    android:textColor="#DDFFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:text="Visitors"
                    android:textColor="#DDFFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ভিআইপি এবং ওয়ালেট বাটন -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#4A148C"
                android:padding="15dp"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <TextView
                    android:text="👑 VIP Status"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:text="(Locked)"
                    android:textColor="#FFEB3B"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#004D40"
                android:padding="15dp"
                android:gravity="center">
                <TextView
                    android:text="💰 Wallet / Recharge"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:text="(Locked)"
                    android:textColor="#00E676"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
