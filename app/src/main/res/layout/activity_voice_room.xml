<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:id="@+id/rootLayout">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/headerProfileLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:cardCornerRadius="22.5dp"
                app:cardElevation="0dp">
                <ImageView android:id="@+id/ivRoomAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/sym_def_app_icon"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SR Room"
                    android:textColor="#DDA0FF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <TextView android:id="@+id/tvRoomIds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: 8772164"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView android:id="@+id/ivHomeSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Seats Container (প্রতিটি সিটের ডিপি ও তার নিচে নাম) -->
    <LinearLayout
        android:id="@+id/seatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1 (Seat 1 to 5) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            
            <!-- Seat 1 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 2 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 3 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 4 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 5 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 (Seat 6 to 10) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="15dp">
            
            <!-- Seat 6 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 7 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 8 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 9 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>

            <!-- Seat 10 -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
                <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tvName10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDA0FF" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- রিয়েল-টাইম চ্যাট মেসেজ স্ক্রিনে শো করার জন্য -->
    <TextView android:id="@+id/tvChatDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/seatsContainer"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:textColor="#90EE90"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="6dp"/>

    <!-- Bottom Control Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:paddingHorizontal="16dp">

        <ImageView android:id="@+id/ivMute"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:tint="#FFFFFF"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView android:id="@+id/ivMic"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"/>

        <EditText android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:hint="Type..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <ImageView android:id="@+id/ivSendChat"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#FFFFFF"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>
