<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B0028">

    <!-- হেডার: ওনার ইনফো এবং রুমের নাম -->
    <LinearLayout
        android:id="@+id/roomHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtOwnerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ওনার নাম (আইডি: ১২৩৪৫)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRoomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="রুমের নাম (সম্পাদনাযোগ্য)"
            android:textColor="#FFD700"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- সিট লেআউট (উপরের অংশে ১০টি গোল সিট) -->
    <GridLayout
        android:id="@+id/seatGridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/roomHeader"
        android:layout_centerHorizontal="true"
        android:layout_margin="16dp"
        android:alignmentMode="alignMargins"
        android:columnCount="5"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <!-- সিট ১ থেকে ১০ -->
        <Button android:id="@+id/seat1" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="1" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat2" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="2" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat3" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="3" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat4" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="4" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat5" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="5" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat6" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="6" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat7" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="7" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat8" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="8" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat9" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="9" android:textColor="#FFFFFF" />
        <Button android:id="@+id/seat10" android:layout_width="60dp" android:layout_height="60dp" android:background="@android:drawable/dialog_holo_dark_frame" android:text="10" android:textColor="#FFFFFF" />

    </GridLayout>

    <!-- স্ক্রিনের নিচে কন্ট্রোল আইকনগুলো (SMS, Emoji, Gift, Mic, Games) -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#2C003E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:weightSum="5">

        <!-- ১. SMS -->
        <ImageView
            android:id="@+id/btnSms"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_communication_clear_portal"
            app:tint="#FFFFFF" />

        <!-- ২. Emoji -->
        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star"
            app:tint="#FFD700" />

        <!-- ৩. Gift (মাঝখানে) -->
        <ImageView
            android:id="@+id/btnGift"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#E91E63" />

        <!-- ৪. Mic -->
        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="#FFFFFF" />

        <!-- ৫. Games -->
        <ImageView
            android:id="@+id/btnGames"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_media_play"
            app:tint="#00E676" />

    </LinearLayout>

</RelativeLayout>
