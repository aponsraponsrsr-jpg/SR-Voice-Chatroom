<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Bar: Room Title & ID - Edit থেকে আসবে -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#1E1E1E">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sr voice chat"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 121"
                android:textColor="#FFC107"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 1: Seat 1 to 5 - উপরে -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:padding="8dp"
        android:gravity="center">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat1" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat2" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat3" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat4" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat5" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 2: Seat 6 to 10 - নিচে -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:padding="8dp"
        android:gravity="center">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat6" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat7" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat8" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat9" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <ImageView android:id="@+id/seat10" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/circle_bg" android:src="@android:drawable/sym_def_app_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Announcement / Welcome Area - মাঝখানে হার্ট ওয়ালপেপার এর মত -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1A1A1A"
        android:padding="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="❤️" android:textSize="50sp" android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notice: welcome - স্বাগতম সবাইকে"
            android:textColor="#FFC107"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="#2A2A2A"
            android:layout_marginTop="15dp"/>
    </LinearLayout>

    <!-- Bottom Action Bar: mic, Chat sms, gift box, game -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:weightSum="6">

        <ImageView android:id="@+id/btnMic" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:src="@android:drawable/ic_btn_speak_now" android:background="#333333" android:padding="8dp"/>

        <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="2.5"
            android:hint="Chat sms..." android:textColor="#FFFFFF" android:textColorHint="#777777"
            android:background="#2E2E2E" android:paddingHorizontal="12dp" android:textSize="13sp" android:layout_marginHorizontal="8dp"/>

        <ImageView android:id="@+id/btnGift" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:src="@android:drawable/ic_menu_gallery" android:background="#333333" android:padding="8dp" android:layout_marginEnd="5dp"/>

        <ImageView android:id="@+id/btnGame" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:src="@android:drawable/ic_media_play" android:background="#333333" android:padding="8dp"/>

        <Button android:id="@+id/btnSend" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.5"
            android:text=">" android:backgroundTint="#FFC107" android:textColor="#000000" android:layout_marginStart="5dp" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
