<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1D3A">

    <!-- Top Header Layout -->
    <RelativeLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/headerProfileLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivHeaderProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Name"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoomIds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: 11458875"
                    android:textColor="#00FFCC"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ivOnlineMembers"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="#66000000"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_myplaces" />

                <TextView
                    android:id="@+id/tvOnlineCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivHomeSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="#66000000"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Seats Container (Circular Design & Top Positioned) -->
    <LinearLayout
        android:id="@+id/seatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topHeader"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Row 1: Seats 1 to 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat1" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat2" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat3" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat4" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat5" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Seats 6 to 10 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat6" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat7" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat8" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat9" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/seat10" android:layout_width="56dp" android:layout_height="56dp" android:background="@android:drawable/presence_invisible" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tvName10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Display Area -->
    <LinearLayout
        android:id="@+id/chatAreaLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/seatsContainer"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvChat1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#40000000"
            android:padding="4dp"
            android:text="Welcome to SR Voice Room"
            android:textColor="#E0E0E0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvChat2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#40000000"
            android:padding="4dp"
            android:textColor="#00FFCC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/ivMute"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_lock_silent_mode" />

        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_btn_speak_now" />

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#33FFFFFF"
            android:hint="Type message..."
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivSendChat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_send" />

        <ImageView
            android:id="@+id/ivGift"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_agenda" />

        <ImageView
            android:id="@+id/ivGames"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_manage" />
    </LinearLayout>

</RelativeLayout>
