<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E1">
    <!-- HEADER - SMALL, RANKING UP NEAR POWER -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FF9800" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <androidx.cardview.widget.CardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="22dp" app:cardElevation="0dp">
            <ImageView android:id="@+id/roomHeaderProfileImg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" />
        </androidx.cardview.widget.CardView>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/roomTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sr Official's Room" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/roomInfoText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID: 499506534" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <!-- RANKING + COINS - SAME AS BEFORE, NOW UP HERE -->
        <TextView android:id="@+id/btnInRoomRanking" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="18sp" android:padding="3dp" />
        <TextView android:id="@+id/textRoomCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪙 0" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingEnd="6dp" />
        <!-- RIGHT COLUMN: POWER TOP, ONLINE BELOW -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <androidx.cardview.widget.CardView android:id="@+id/btnPower" android:layout_width="34dp" android:layout_height="34dp" app:cardCornerRadius="17dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="⏻" android:textSize="19sp" android:textColor="#222222" android:textStyle="bold" android:gravity="center" />
            </androidx.cardview.widget.CardView>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/textOnlineCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnOnlineList" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="14sp" android:padding="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/roomNoticeBarText" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:background="#FFF3CD" android:textColor="#3E2F00" android:textSize="13sp" android:padding="8dp" />
    <!-- FIXED: JAVA FILE ER JONNO MISSING 3 TA ID EKHANE LUKANO OBOSTHAY ADD KORA - NAHOLE BUILD FAIL KORBE -->
    <TextView
        android:id="@+id/btnRoomEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/layoutOwnerTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:paddingTop="6dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="2dp">
        <LinearLayout android:id="@+id/seat_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_0" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Host" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_1" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_2" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_3" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_4" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:padding="8dp">
        <LinearLayout android:id="@+id/seat_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_5" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_6" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_7" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_8" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
        <LinearLayout android:id="@+id/seat_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp"><TextView android:id="@+id/seatImg_9" android:layout_width="56dp" android:layout_height="56dp" android:text="🪑" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_seat_bg" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#222222" /></LinearLayout>
    </LinearLayout>
    <ScrollView android:id="@+id/chatScrollView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/chatListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" /></ScrollView>
    <LinearLayout android:id="@+id/bottomBarContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FFFFFF" android:padding="8dp">
        <TextView android:id="@+id/btnOpenChat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💬  Say something..." android:textColor="#999999" android:textSize="14sp" android:background="#F5F5F5" android:padding="12dp" />
        <TextView android:id="@+id/btnGiftBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎁" android:textSize="22sp" android:padding="8dp" />
        <TextView android:id="@+id/btnGame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎮" android:textSize="22sp" android:padding="8dp" />
        <TextView android:id="@+id/btnRoomTools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛠️" android:textSize="22sp" android:padding="8dp" />
        <TextView android:id="@+id/btnMicToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎤" android:textSize="22sp" android:padding="8dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/chatPopupBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:background="#FFFFFF" android:padding="8dp">
        <EditText android:id="@+id/inputChatMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Type message..." android:textSize="14sp" android:background="#F5F5F5" android:padding="12dp" />
        <TextView android:id="@+id/btnChatOption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#FF9800" android:padding="12dp" />
    </LinearLayout>
</LinearLayout>
