<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView android:id="@+id/ivRoomAvatar"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/sym_def_app_icon"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView android:id="@+id/tvRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ham&quot;Tum"
                android:textColor="#DDA0FF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView android:id="@+id/tvRoomIds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 11458875"
                android:textColor="white"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageView android:id="@+id/ivHomeSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_preferences"/>
    </LinearLayout>

    <!-- Seats Grid -->
    <GridLayout
        android:id="@+id/seatsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:columnCount="5"
        android:padding="10dp"
        android:rowCount="2">

        <ImageView android:id="@+id/seat1" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat2" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat3" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat4" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat5" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat6" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat7" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat8" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat9" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>
        <ImageView android:id="@+id/seat10" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="8dp" android:background="#40FFFFFF"/>

    </GridLayout>

    <TextView android:id="@+id/tvSeat3Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/seatsGrid"
        android:layout_centerHorizontal="true"
        android:text="Ham&quot;Tum"
        android:textColor="#DDA0FF"/>

    <TextView android:id="@+id/tvEntryLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSeat3Name"
        android:layout_margin="20dp"
        android:text="no body come to my room"
        android:textColor="#90EE90"/>

</RelativeLayout>
