<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1D3A"
    android:padding="12dp">

    <!-- Top Header Layout -->
    <LinearLayout
        android:id="@+id/headerProfileLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_bg"
        android:padding="6dp">

        <ImageView
            android:id="@+id/ivHeaderProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Name"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRoomIds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 11458875"
                android:textColor="#DDA0FF"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Top Right Icons (Online Members & Exit) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Online Members Icon & Count -->
        <LinearLayout
            android:id="@+id/ivOnlineMembers"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#22FFFFFF"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@android:color/white"/>

            <TextView
                android:id="@+id/tvOnlineCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Exit / Settings Button -->
        <ImageView
            android:id="@+id/ivHomeSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@android:color/white"
            android:background="#22FFFFFF"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Seats Section (1 to 10) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:columnCount="5"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:gravity="center">

        <!-- Seat 1 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat1" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 2 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat2" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 3 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat3" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 4 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat4" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 5 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat5" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 6 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat6" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 7 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat7" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 8 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat8" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 9 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat9" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>

        <!-- Seat 10 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/seat10" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/circle_seat_bg" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/tvName10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>
    </GridLayout>

    <!-- Bottom Chat & Control Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChat1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#90EE90"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"/>

        <TextView
            android:id="@+id/tvChat2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivMute"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:tint="@android:color/white"
                android:layout_marginEnd="6dp"/>

            <ImageView
                android:id="@+id/ivMic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@android:color/white"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Type..."
                android:textColorHint="#808080"
                android:textColor="@android:color/white"
                android:background="#22FFFFFF"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"/>

            <ImageView
                android:id="@+id/ivSendChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="@android:color/white"
                android:layout_marginStart="6dp"/>

            <ImageView
                android:id="@+id/ivGift"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@android:color/white"
                android:layout_marginStart="6dp"/>

            <ImageView
                android:id="@+id/ivGames"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@android:color/white"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
