<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Bar: Room Title & Theme/Room Edit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SR Voice Chat Room"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/editRoomButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#FF2A6D"
            android:text="Edit Room &amp; Seats"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Room Info / Theme Banner Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#1E1E1E"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Room Theme: Default Dark"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to SR Voice Chat!"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Seats Grid Layout (Interactive Voice Seats) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:gravity="center"
        android:rowCount="3">

        <!-- Seat 1 (Owner / Host) -->
        <Button
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            android:backgroundTint="#2C2C2C"
            android:text="Seat 1\n(Host)"
            android:textColor="#FF2A6D"
            android:textSize="12sp" />

        <!-- Seat 2 -->
        <Button
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            android:backgroundTint="#2C2C2C"
            android:text="Seat 2"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- Seat 3 -->
        <Button
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            android:backgroundTint="#2C2C2C"
            android:text="Seat 3"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- Seat 4 -->
        <Button
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            android:backgroundTint="#2C2C2C"
            android:text="Seat 4"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- Seat 5 -->
        <Button
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            android:backgroundTint="#2C2C2C"
            android:text="Seat 5"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- Seat 6 -->
        <Button
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            android:backgroundTint="#2C2C2C"
            android:text="Seat 6"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </GridLayout>

</LinearLayout>
