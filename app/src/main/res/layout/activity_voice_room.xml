<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/voice_room_bg">

    <!-- Top Bar: Room Title, VIP Tag & Power Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#22000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 SR Official Voice Room 🌟"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 777888 | 👑 VIP Room"
                android:textColor="#FFD700"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Power / Exit Button -->
        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="#FF4081"
            android:contentDescription="Power Button" />
    </LinearLayout>

    <!-- Notice Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 Notice: এসআর ভয়েস চ্যাটরুমে সবাইকে স্বাগতম! কেউ কাউকে অশ্লীল গালিগালাজ করবেন না।"
        android:textColor="#FFEB3B"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="#44000000"
        android:layout_margin="8dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- 10 Voice Seats Grid Container -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:padding="4dp"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:gravity="center">

        <!-- Seat 1: Host -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt1" android:layout_width="60dp" android:layout_height="wrap_content" android:text="Host" android:textColor="#00E676" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 2 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt2" android:layout_width="60dp" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 3 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt3" android:layout_width="60dp" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 4 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt4" android:layout_width="60dp" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 5 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt5" android:layout_width="60dp" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 6 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard6"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt6" android:layout_width="60dp" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 7 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard7"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt7" android:layout_width="60dp" android:layout_height="wrap_content" android:text="7" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 8 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard8"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt8" android:layout_width="60dp" android:layout_height="wrap_content" android:text="8" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 9 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard9"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg9"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt9" android:layout_width="60dp" android:layout_height="wrap_content" android:text="9" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 10 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard10"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                android:backgroundTint="#222222">
                <ImageView
                    android:id="@+id/seatImg10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:padding="12dp"
                    android:tint="#888888"/>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt10" android:layout_width="60dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

    </GridLayout>

    <!-- Screen Chat Messages List -->
    <ListView
        android:id="@+id/chatListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:stackFromBottom="true"
        android:transcriptMode="normal"
        android:padding="8dp"/>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:background="#22000000"
        android:gravity="center"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btnMicToggle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🎙️ Mic"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#00E676"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnChatOption"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="💬 Chat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnGiftBox"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🎁 Gift"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#FFD700"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnGameBox"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🎮 Game"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#00E5FF"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
