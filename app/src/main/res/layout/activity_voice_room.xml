<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:id="@+id/rootLayout">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/headerProfileLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:cardCornerRadius="22.5dp"
                app:cardElevation="0dp">
                <ImageView android:id="@+id/ivRoomAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/sym_def_app_icon"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official's Room"
                    android:textColor="#DDA0FF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <TextView android:id="@+id/tvRoomIds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: 21133805"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView android:id="@+id/ivHomeSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Seats Container (১০টি সিট এবং নিচে সিরিয়াল নম্বর ও নাম) -->
    <LinearLayout
        android:id="@+id/seatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1 (Seat 1 to 5) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 (Seat 6 to 10) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_margin="5dp">
                <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardBackgroundColor="#2A2A2A" app:cardElevation="0dp">
                    <ImageView android:id="@+id/seat10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:textColor="#888888" android:textSize="10sp"/>
                <TextView android:id="@+id/tvName10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDA0FF" android:textSize="11sp" android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- বাঁ পাশে স্ক্রিনশটের মতো চ্যাট মেসেজ দেখানোর জন্য লিস্ট বা লেআউট -->
    <LinearLayout
        android:id="@+id/chatListContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/seatsContainer"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingBottom="10dp">

        <TextView android:id="@+id/tvChat1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90EE90"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingVertical="2px"/>

        <TextView android:id="@+id/tvChat2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90EE90"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingVertical="2px"/>
    </LinearLayout>

    <!-- Bottom Control Bar (মাইক, স্পিকার, টাইপিং বক্স, গিফট এবং গেম আইকন সহ) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:paddingHorizontal="12dp">

        <ImageView android:id="@+id/ivMute"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:tint="#FFFFFF"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView android:id="@+id/ivMic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <EditText android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:hint="Type..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <ImageView android:id="@+id/ivSendChat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#FFFFFF"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- গিফট আইকন -->
        <ImageView android:id="@+id/ivGift"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="#FFD700"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- গেম আইকন -->
        <ImageView android:id="@+id/ivGames"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#00FFFF"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>
