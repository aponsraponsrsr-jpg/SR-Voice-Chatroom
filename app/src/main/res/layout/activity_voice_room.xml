<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/voice_room_bg">

    <!-- Top Bar: Clean & Premium Compact Banner Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#33000000">

        <!-- Header Profile Picture -->
        <androidx.cardview.widget.CardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="19dp"
            app:cardElevation="2dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@android:color/transparent">
            <ImageView
                android:id="@+id/roomHeaderProfileImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_my_calendar"/>
        </androidx.cardview.widget.CardView>

        <!-- Room Name & ID -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SR Voice Room"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/roomInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 493859069"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- 🌟 Room Tools / Owner Control Panel Icon (Four-Leaves / Menu Icon) -->
        <ImageView
            android:id="@+id/btnRoomTools"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#00E5FF"
            android:layout_marginEnd="8dp"
            android:contentDescription="Room Tools"/>

        <!-- 🌟 Golden Cup Icon with "Rank" Text -->
        <LinearLayout
            android:id="@+id/btnInRoomRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="2dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#FFD700"
                android:contentDescription="Cup Ranking"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rank"
                android:textColor="#FFD700"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Online Member Count & Icon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/btnOnlineList"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#00E676"
                android:contentDescription="Online List"/>

            <TextView
                android:id="@+id/textOnlineCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="2dp"/>
        </LinearLayout>

        <!-- Power / Exit Button -->
        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="#FF4081"
            android:contentDescription="Power Button" />
    </LinearLayout>

    <!-- Notice Bar -->
    <TextView
        android:id="@+id/roomNoticeBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 Notice: এসআর ভয়েস চ্যাটরুমে সবাইকে স্বাগতম!"
        android:textColor="#FFEB3B"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="#44000000"
        android:layout_margin="8dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- 10 Voice Seats Grid Container -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:padding="6dp"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:gravity="center">

        <!-- Seat 1: Host -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000"
                app:cardPreventCornerOverlap="false">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt1" android:layout_width="65dp" android:layout_height="wrap_content" android:text="Host" android:textColor="#00E676" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 2 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000"
                app:cardPreventCornerOverlap="false">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt2" android:layout_width="65dp" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 3 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt3" android:layout_width="65dp" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 4 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt4" android:layout_width="65dp" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 5 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt5" android:layout_width="65dp" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 6 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard6"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt6" android:layout_width="65dp" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 7 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard7"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt7" android:layout_width="65dp" android:layout_height="wrap_content" android:text="7" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 8 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard8"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt8" android:layout_width="65dp" android:layout_height="wrap_content" android:text="8" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 9 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard9"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt9" android:layout_width="65dp" android:layout_height="wrap_content" android:text="9" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Seat 10 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="6dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/seatCard10"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22000000">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_gold"
                    android:padding="2.5dp">
                    <ImageView
                        android:id="@+id/seatImg10"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle_pink"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/seatTxt10" android:layout_width="65dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

    </GridLayout>

    <!-- Screen Chat Messages List (Properly positioned above action bar) -->
    <ListView
        android:id="@+id/chatListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:stackFromBottom="true"
        android:transcriptMode="normal"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- 🌟 Lifted & Fully Visible Ultra Premium Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="#44000000"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <!-- Mic Button -->
        <Button
            android:id="@+id/btnMicToggle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎙️ Mic"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#00E676"
            android:layout_marginHorizontal="5dp"
            android:textStyle="bold"
            android:elevation="6dp"/>

        <!-- Chat Button -->
        <Button
            android:id="@+id/btnChatOption"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="💬 Chat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#5E35B1"
            android:layout_marginHorizontal="5dp"
            android:textStyle="bold"
            android:elevation="6dp"/>

        <!-- Gift Button -->
        <Button
            android:id="@+id/btnGiftBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎁 Gift"
            android:textColor="#111111"
            android:textSize="12sp"
            android:backgroundTint="#FFD700"
            android:layout_marginHorizontal="5dp"
            android:textStyle="bold"
            android:elevation="6dp"/>

        <!-- Game Button -->
        <Button
            android:id="@+id/btnGameBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎮 Game"
            android:textColor="#111111"
            android:textSize="12sp"
            android:backgroundTint="#00E5FF"
            android:layout_marginHorizontal="5dp"
            android:textStyle="bold"
            android:elevation="6dp"/>

    </LinearLayout>

</LinearLayout>
