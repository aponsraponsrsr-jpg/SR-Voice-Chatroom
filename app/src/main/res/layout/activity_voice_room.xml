<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- রুমের ব্যাকগ্রাউন্ড বা থিম এরিয়া -->
    <ImageView
        android:id="@+id/roomBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:color/darker_gray" />

    <!-- ১. বাম পাশের উপরে: ডিপি (Profile Picture) এবং আইডি / নাম ডিসপ্লে -->
    <LinearLayout
        android:id="@+id/topProfileLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_bg"
        android:padding="6dp">

        <!-- গোল ডিপি (Profile Image) -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_shape" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Voice Room"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/userIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 1000000"
                android:textColor="#FFD700"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ২. রুমের ভেতরে গোল গোল সিট লেআউট (Seat 1 to 6) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topProfileLayout"
        android:layout_above="@id/bottomControlBar"
        android:layout_centerHorizontal="true"
        android:layout_margin="20dp"
        android:columnCount="3"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:rowOrderPreserved="false"
        android:gravity="center">

        <!-- Host / Seat 1 -->
        <Button
            android:id="@+id/seat1Btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:background="@drawable/circle_shape"
            android:text="Host\nSeat 1"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <!-- Seat 2 -->
        <Button
            android:id="@+id/seat2Btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:background="@drawable/circle_shape"
            android:text="Seat 2"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <!-- Seat 3 -->
        <Button
            android:id="@+id/seat3Btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:background="@drawable/circle_shape"
            android:text="Seat 3"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <!-- Seat 4 -->
        <Button
            android:id="@+id/seat4Btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:background="@drawable/circle_shape"
            android:text="Seat 4"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <!-- Seat 5 -->
        <Button
            android:id="@+id/seat5Btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:background="@drawable/circle_shape"
            android:text="Seat 5"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <!-- Seat 6 -->
        <Button
            android:id="@+id/seat6Btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:background="@drawable/circle_shape"
            android:text="Seat 6"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </GridLayout>

    <!-- ৩. একদম নিচের কন্ট্রোল বার (Bottom Bar: Mic, Chat, Gift, Menu) -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <!-- Speaker Mute Button -->
        <Button
            android:id="@+id/serialBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_shape"
            android:text="🎤" />

        <!-- Type Chat Box -->
        <EditText
            android:id="@+id/chatInputBox"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/rounded_bg"
            android:hint="Type a message..."
            android:textColorHint="#AAAAAA"
            android:textColor="@android:color/white"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />

        <!-- Chat Button -->
        <Button
            android:id="@+id/chatBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_shape"
            android:text="💬" />

        <!-- Gift Box Button -->
        <Button
            android:id="@+id/giftBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_shape"
            android:text="🎁" />

        <!-- Edit Room / Menu Button (Right Corner) -->
        <Button
            android:id="@+id/editRoomButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_shape"
            android:text="⚙️"
            android:textColor="@android:color/white" />
    </LinearLayout>

</RelativeLayout>
