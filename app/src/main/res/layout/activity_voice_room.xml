<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/voice_room_bg">

    <!-- Top Bar: Room Title, ID & Power Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#22000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 SR Official Voice Room 🌟"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 777888 | 👑 VIP Room"
                android:textColor="#FFD700"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Power / Exit Button -->
        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="#FF4081"
            android:contentDescription="Power Button" />
    </LinearLayout>

    <!-- Voice Seats Grid Container (रঙিন ও আকর্ষণীয় সিট) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="16dp"
        android:gravity="center">

        <!-- Seat 1 (Active Speaker) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <View
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/seat_circle_active"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Host"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Seat 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <View
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/seat_circle_normal"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Seat 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <View
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/seat_circle_normal"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Seat 4 (Locked) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <View
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/seat_circle_locked"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Locked"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </GridLayout>

    <!-- Chat / Message Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#33000000"
        android:padding="12dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📢 Notice: এসআর ভয়েস চ্যাটরুমে সবাইকে স্বাগতম! কেউ কাউকে অশ্লীল গালিগালাজ করবেন না।"
            android:textColor="#FFEB3B"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#44000000"/>
    </LinearLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:background="#22000000"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <EditText
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Say something..."
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BEC5"
            android:background="#55000000"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            text="Send"
            android:backgroundTint="#FF4081"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
