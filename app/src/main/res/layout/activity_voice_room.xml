<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Header (বাম পাশে প্রোফাইল/নাম/আইডি এবং ডানে এক্সিট/সেটিংস) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#222222"
        android:paddingHorizontal="12dp">

        <!-- বাম পাশের হেডার (প্রোফাইল পিক + নাম ও আইডি) -->
        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:cardCornerRadius="22.5dp"
            app:cardElevation="0dp">
            <ImageView android:id="@+id/ivRoomAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView android:id="@+id/tvRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Group"
                android:textColor="#DDA0FF"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView android:id="@+id/tvRoomIds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 11458875"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- ডান পাশের এক্সিট বা হোম সেটিংস আইকন -->
        <ImageView android:id="@+id/ivHomeSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"/>
    </LinearLayout>

    <!-- Seats Container (১ থেকে ১০ নম্বর গোল সিটগুলো) -->
    <LinearLayout
        android:id="@+id/seatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1 (Seat 1 to 5) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            
            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 2 (Seat 6 to 10) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            
            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="6dp" app:cardCornerRadius="27.5dp" app:cardBackgroundColor="#333333" app:cardElevation="0dp">
                <ImageView android:id="@+id/seat10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tvSeat3Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/seatsContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="User Name"
        android:textColor="#DDA0FF"
        android:textSize="13sp"/>

    <TextView android:id="@+id/tvEntryLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSeat3Name"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:text="no body come to my room"
        android:textColor="#90EE90"
        android:padding="8dp"/>

    <!-- Bottom Control Bar (সবার নিচে কন্ট্রোল বার ও আইকনগুলো) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#222222"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:tint="#FFFFFF"
            android:layout_marginEnd="16dp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#333333"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:text="Type..."
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#FFFFFF"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

</RelativeLayout>
