<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/voice_room_bg">

    <!-- ============ HEADER ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvRoomTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Voice Room"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 123456"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOnlineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 0 Online"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_circle_pink"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

    <!-- ============ SEATS - ROW 1 - SEAT 1 TO 5 ============ -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:padding="8dp">

        <!-- SEAT 1 - HOST -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_0"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_host"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_0" android:layout_width="65dp" android:layout_height="wrap_content" android:text="Host" android:textColor="#00E676" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="1" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 2 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_1"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_1" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 3 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_2"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_2" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 4 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_3"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_3" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 5 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_4"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_4" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 6 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_5"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_5" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 7 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_6"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_6" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="7" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 8 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_7"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_7" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="8" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 9 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_8"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_8" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="9" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- SEAT 10 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <FrameLayout
                android:id="@+id/seat_9"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_seat_empty"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/seatImg_9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="14dp" android:src="@drawable/seat_sofa" />
            </FrameLayout>
            <TextView android:id="@+id/seatName_9" android:layout_width="65dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>
    </GridLayout>

    <!-- ============ CHAT AREA ============ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp" />

    <!-- ============ BOTTOM BAR ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#40000000">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Type message..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"
            android:background="@drawable/bg_edittext"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_send"
            android:padding="10dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_chat" />

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:padding="10dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_mic" />

        <ImageView
            android:id="@+id/btnGift"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:padding="10dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_gift" />
    </LinearLayout>
</LinearLayout>
