<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B1035">

    <!-- TOP BAR - HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#2A1B4A">

        <ImageView
            android:id="@+id/roomHeaderProfileImg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_profile_gradient"
            android:src="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">
            <TextView
                android:id="@+id/roomTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sr Official's Room"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/roomInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 499506534"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textOnlineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/btnOnlineList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥"
            android:textSize="20sp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/btnPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏻"
            android:textSize="20sp"
            android:textColor="#FF5252"
            android:padding="6dp" />
    </LinearLayout>

    <!-- NOTICE -->
    <TextView
        android:id="@+id/roomNoticeBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:visibility="gone"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="#3B2A00" />

    <!-- COINS + RANKING + WALLET ROW - SOBAR JONNO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/textRoomCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🪙 0"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInRoomRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 Ranking"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="8dp"
            android:background="#7B1FA2" />

        <TextView
            android:id="@+id/btnWallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 Wallet"
            android:textColor="#222222"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="#FFC107"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- SEATS - 10 TA - SOBAR JONNO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#2A1B4A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/seat_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_0" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Host" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_1" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_2" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_3" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_4" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/seat_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_5" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_6" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_7" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_8" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <TextView android:id="@+id/seatImg_9" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="@drawable/circle_seat_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- CHAT LIST -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/chatListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>

    <!-- CHAT POPUP -->
    <LinearLayout
        android:id="@+id/chatPopupBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:visibility="gone">
        <EditText
            android:id="@+id/inputChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type message..."
            android:textSize="14sp"
            android:padding="10dp" />
        <TextView
            android:id="@+id/btnChatOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="#FF9800" />
    </LinearLayout>

    <!-- BOTTOM BAR - SOBAR JONNO -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/btnOpenChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬 Chat"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnGiftBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎁 Gift"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnGame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎮 Game"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnRoomTools"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛠️ Tools"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnMicToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎤 Mic"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
