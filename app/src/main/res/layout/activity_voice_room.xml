<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/voice_room_bg">

    <!-- Top Bar: Room Title, VIP Tag & Power Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#22000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 SR Official Voice Room 🌟"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 777888 | 👑 VIP Room"
                android:textColor="#FFD700"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Power / Exit Button -->
        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="#FF4081"
            android:contentDescription="Power Button" />
    </LinearLayout>

    <!-- Notice Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 Notice: এসআর ভয়েস চ্যাটরুমে সবাইকে স্বাগতম! কেউ কাউকে অশ্লীল গালিগালাজ করবেন না।"
        android:textColor="#FFEB3B"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="#44000000"
        android:layout_margin="8dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- 10 Voice Seats Grid Container (১০টি গোল গোল প্রিমিয়াম সিট) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:padding="6dp"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:gravity="center">

        <!-- Seat 1: Host (Active) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat1" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Host" android:textColor="#00E676" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat2" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat3" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat4" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat5" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 6 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat6" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 7 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat7" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 8 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat8" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 9 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat9" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_normal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Seat 10: Locked -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">
            <View android:id="@+id/seat10" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/seat_circle_locked"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locked" android:textColor="#FF5252" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

    </GridLayout>

    <!-- Bottom Action Bar (চারটি প্রিমিয়াম বাটন: মাইক, এসএমএস, গিফট বক্স, গেম বক্স) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:background="#22000000"
        android:gravity="center"
        android:paddingHorizontal="8dp">

        <!-- ১. মাইক মিউট/আনমিউট -->
        <Button
            android:id="@+id/btnMicToggle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🎙️ Mic"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#00E676"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

        <!-- ২. এসএমএস / চ্যাট -->
        <Button
            android:id="@+id/btnChatOption"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="💬 Chat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

        <!-- ৩. গিফট বক্স -->
        <Button
            android:id="@+id/btnGiftBox"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🎁 Gift"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#FFD700"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

        <!-- ৪. গেম বক্স -->
        <Button
            android:id="@+id/btnGameBox"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🎮 Game"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#00E5FF"
            android:layout_marginHorizontal="4dp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
