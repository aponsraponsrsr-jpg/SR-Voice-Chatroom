<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1"
    android:orientation="vertical">

    <!-- Top Bar with Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0A0A0A"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Beach Heart Room"
            android:textColor="#D4AF37"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <!-- Settings Icon - Top Right -->
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⚙️"
            android:gravity="center"
            android:background="@drawable/rounded_bg"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- 10 Seats on Top - Beach Heart Theme -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:padding="12dp"
        android:background="#FFE0B2">

        <!-- 10 Seats - Sample -->
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="👑" android:gravity="center" android:textSize="24sp"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:background="@drawable/rounded_bg" android:text="💛" android:gravity="center"/>
    </GridLayout>

    <!-- Chat Area -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Chat messages here..."
        android:padding="16dp"/>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#111111">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎤 Mic" android:textColor="white" android:padding="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎁 Gift" android:textColor="#D4AF37" android:padding="12dp"/>
    </LinearLayout>

</LinearLayout>
