<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- HEADER - SIMPLE WHITE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/roomHeaderProfileImg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="👤"
            android:textSize="22sp"
            android:background="#FFF8E1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:id="@+id/roomTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sr Official's Room"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/roomInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 499506534"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textOnlineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOnlineList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥"
            android:textSize="18sp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/btnPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏻"
            android:textSize="18sp"
            android:textColor="#222222"
            android:padding="6dp" />
    </LinearLayout>

    <!-- RANKING CUP - SIMPLE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnInRoomRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="18sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textRoomCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="498"
            android:textColor="#B8860B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ›"
            android:textColor="#222222"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnWallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

    <!-- SEATS - SIMPLE GHEE COLOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#FFF8E1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/seat_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_0" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_1" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_2" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_3" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_4" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/seat_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_5" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_6" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_7" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_8" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <TextView android:id="@+id/seatImg_9" android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="🪑" android:textSize="22sp" android:background="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:textColor="#222222" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="All" android:textColor="#FF9800" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chat" android:textColor="#222222" android:textSize="13sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gift" android:textColor="#222222" android:textSize="13sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Notice" android:textColor="#222222" android:textSize="13sp" android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/roomNoticeBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="wlc"
        android:textColor="#222222"
        android:textSize="13sp"
        android:padding="8dp"
        android:background="#FFF8E1" />

    <!-- CHAT LIST -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/chatListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>

    <!-- CHAT POPUP -->
    <LinearLayout
        android:id="@+id/chatPopupBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:visibility="gone">
        <EditText
            android:id="@+id/inputChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type message..."
            android:textSize="14sp"
            android:padding="10dp" />
        <TextView
            android:id="@+id/btnChatOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="#FF9800" />
    </LinearLayout>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/btnOpenChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬 Type..."
            android:textSize="14sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/btnGiftBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎁 Gift"
            android:textSize="14sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/btnGame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎮 Game"
            android:textSize="14sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/btnRoomTools"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛠️ Tools"
            android:textSize="14sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/btnMicToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎤 Mic"
            android:textSize="14sp"
            android:textColor="#222222" />
    </LinearLayout>
</LinearLayout>
