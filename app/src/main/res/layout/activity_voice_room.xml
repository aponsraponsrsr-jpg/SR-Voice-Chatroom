<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0A1E"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E91E63"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 SR Official Voice Room 🌟"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 777888 | 👑 VIP Room"
                android:textColor="#FFEB3B"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btnPower"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⏻"
            android:textColor="#FFFFFF"
            android:background="#88000000"
            android:textSize="28sp"
            android:gravity="center"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvNotice"
        android:layout_below="@id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 Notice: এসআর ভয়েস চ্যাটরুমে সবাইকে স্বাগতম!"
        android:textColor="#FFEB3B"
        android:background="#1A1A1A"
        android:padding="10dp"
        android:textSize="13sp"
        android:layout_margin="8dp"/>

    <LinearLayout
        android:id="@+id/seatsContainer"
        android:layout_below="@id/tvNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:gravity="center">
            <FrameLayout android:id="@+id/seat1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_host" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5">
            <FrameLayout android:id="@+id/seat6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_normal" />
            </FrameLayout>
            <FrameLayout android:id="@+id/seat10" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/bg_seat_empty" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:weightSum="4"
        android:padding="10dp"
        android:layout_marginBottom="16dp"
        android:background="#1E0F3A">

        <TextView android:id="@+id/btnMic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_mic" android:text="🎙️ Mic" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold"/>
        <TextView android:id="@+id/btnChat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_chat" android:text="💬 Chat" android:textColor="#FFFFFF" android:gravity="center"/>
        <TextView android:id="@+id/btnGift" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_gift" android:text="🎁 Gift" android:textColor="#000000" android:gravity="center" android:textStyle="bold"/>
        <TextView android:id="@+id/btnGame" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_game" android:text="🎮 Game" android:textColor="#000000" android:gravity="center" android:textStyle="bold"/>
    </LinearLayout>
</RelativeLayout>
