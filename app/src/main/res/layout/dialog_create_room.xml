<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1A1A2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Room"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:hint="Edit Name - তোমার নাম"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#2A2A3E" />

    <TextView
        android:id="@+id/tvRoomProfile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="Room Profile - ছবি সিলেক্ট করো 📷"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:background="#2A2A3E" />

    <EditText
        android:id="@+id/etRoomName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:hint="Room Name - রুমের নাম"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#2A2A3E" />

    <Button
        android:id="@+id/btnConfirmRoom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Confirm - রুম চালু করো"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E91E63" />

</LinearLayout>
