<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== INTERNET + NETWORK ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ===== VOICE ROOM - MIC - MOST IMPORTANT FOR EARNING APP ===== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ===== MEDIA + PROFILE PIC ===== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="SR Voice Chat"
        android:supportsRtl="true"
        android:theme="@style/Theme.SRVoiceChat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SRVoiceChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SRVoiceChat" />

        <activity android:name=".EditProfileActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />
        <activity android:name=".HomeActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />
        <activity android:name=".InboxActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />
        <activity android:name=".MeActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- VIP ACTIVITY - NEW - MeActivity VIP Button Theke Khulbe - EITA NA THAKLE CRASH KORTO -->
        <activity android:name=".VipActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- STORE - FIXED: AGE CHILO NA, TAI INBOX THEKE STORE KHULTO NA - EKHON ADD KORA HOLO -->
        <activity android:name=".StoreActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- VOICE ROOM - FIXED: ROTATE KORLEO ROOM THEKE BER HOBE NA, KEYBOARD UTHLEO BHANGBE NA -->
        <activity
            android:name=".VoiceRoomActivity"
            android:exported="false"
            android:theme="@style/Theme.SRVoiceChat"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <activity android:name=".RoomSetupActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />
        <activity android:name=".AgencyDashboardActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />
        <activity android:name=".PublicProfileActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- GREEDY LION GAME - NEW - FRUIT PARTY OUT, GREEDY LION IN - EITA NA THAKLE GAME KHULTO NA -->
        <activity android:name=".GreedyLionActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" android:screenOrientation="portrait" />

        <!-- PRIVATE CHAT - GLOBAL FRIEND / FOLLOW / SMS - EITA NA THAKLE BUILD FAIL KORTO -->
        <activity android:name=".PrivateChatActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- SELLER BUSINESS WALLET - NEW - PERMANENT - ONLY SELLER SEES - SELLER CANNOT CREATE COINS - PROFILE ID ONLY -->
        <activity android:name=".SellerBusinessWalletActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- SUPER PANEL LOGIN - ADDED - MeActivity Avatar Long Press - EITA NA THAKLE CRASH KORTO -->
        <activity android:name=".SuperPanelLoginActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- HOST CENTER - ADDED - MeActivity Host Center - EITA NA THAKLE CRASH KORTO -->
        <activity android:name=".HostCenterActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- HOST POLICY - ADDED - Host Center Backup - EITA NA THAKLE CRASH KORTO -->
        <activity android:name=".HostPolicyActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

        <!-- AGENCY POLICY - ADDED - Dashboard Policy Button - EITA NA THAKLE CLICK KORLE CRASH KORTO -->
        <activity android:name=".AgencyPolicyActivity" android:exported="false" android:theme="@style/Theme.SRVoiceChat" />

    </application>
</manifest>
